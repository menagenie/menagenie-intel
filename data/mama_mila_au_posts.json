NvwF3RcqG&_nc_gid=BGa9m1K4iLc8U6WnRuUeug&edm=ADp7STQBAAAA&ccb=7-5&oh=00_AQAIlbrunSr68cZWag6cJ6QsHB5KmRJRRz7kSh5FX2gvqg&oe=6A6BDFC8&_nc_sid=c6f216", "videoUrl": "https://scontent-hkg1-1.cdninstagram.com/o1/v/t2/f2/m86/AQNEMQQPzT4NH3Wjd9_okhdhvEnde94Cr6BeL6Oqu6gfWp1G0MgiekXnVU0RF15MwszjPAnpfJVKwDyx3zj2Fzpp5xuferGaLDstWtU.mp4?_nc_cat=105&_nc_sid=5e9851&_nc_ht=scontent-hkg1-1.cdninstagram.com&_nc_ohc=2OQ6Gvm4PKAQ7kNvwFMwp-g&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTU2OTcyNzg3MTE2Mzc5NywiYXNzZXRfYWdlX2RheXMiOjEyLCJ2aV91c2VjYXNlX2lkIjoxMDA5OSwiZHVyYXRpb25fcyI6MTgsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=4a0ca2a5d7b0bd42&_nc_&_nc_gid=e4ng_TtK_qn4mWgw5HmuNA&_nc_ss=72689&_nc_zt=28&oh=00_AQB_jot72R_gTNbyFw1uEerqo1XhPgLdvHKR0MEFEjMR8A&oe=6A67D546", "musicInfo": {"artist_name": "mama_mila_au", "song_name": "Original audio", "uses_original_audio": true, "should_mute_audio": false, "should_mute_audio_reason": "", "audio_id": "28087192517572071"}, "ownerUsername": "mama_mila_au", "ownerFullName": "Chantel Mila", "transcript": "Three tricks that will change the way you store your linen. We all know to store our sheet sets inside a pillowcase, but I like to turn the pillowcase inside out first, then fold the flap over to secure it into a space-saving bundle. Use office file racks to store extra pillowcases and grab them easily, and make Epsom salt and essential oil scent bags to make your linen smell amazing.", "history": [{"date": "2026-07-18", "plays": 225563, "likes": 2093, "comments": 25}, {"date": "2026-07-19", "plays": 227529, "likes": 2115, "comments": 25}, {"date": "2026-07-26", "plays": 270544, "likes": 2588, "comments": 28}], "still_climbing": false, "hook_type": "List", "is_relevant": true}, {"shortCode": "Dar8ir9yQ5F", "url": "https://www.instagram.com/p/Dar8ir9yQ5F/", "caption": "Work smarter, not harder \ud83c\udf3b save these 5 easy cleaning hacks for your next home reset!\n1. Place rice + lemon oil in your wardrobes to aborb moisture and keep mould away\n2. To repel flies, place cloves inside a lemon and place this around your kitchen\n3. Boil lemon, clove and vanilla to make your home smell amazing\n4. Remove makeup stains instantly using shaving cream\n5. And shaving cream is also amazing at cleaning mirrored appliances around the home\n\nHope these quick tips were helpful lovelies! Have an amazing weekend xx\n\n#homehacks #hometips #cleaninghacks #cleaningtips #tipsandtricks", "timestamp": "2026-07-12T08:50:14.000Z", "videoDuration": 22.5, "videoPlayCount": 151762, "videoViewCount": null, "likesCount": 1882, "commentsCount": 15, "displayUrl": "https://scontent-lga3-1.cdninstagram.com/v/t51.82787-15/745334366_18100506602190993_5474503667135871350_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-lga3-1.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gFnfrFTnQJDFhk55qSGF8Q2up9e6YiQSSq3jCN8T2UZg813T283ZAxisqx-VCiQo8o1w1IZelwOcmw3qz7s03SB&_nc_ohc=TFFTVkG31_UQ7kNvwFHGXfS&_nc_gid=gKYI2ZesqQYEXnfEszQMRQ&edm=ADp7STQBAAAA&ccb=7-5&oh=00_AQBy_tzQ7uTaq6JXgCqrRNG-DLTnnho1xqFGv_aw2KyCWA&oe=6A62958A&_nc_sid=c6f216", "videoUrl": "https://scontent-bos5-1.cdninstagram.com/o1/v/t2/f2/m86/AQM7m1iMtV4r1CYqqe-eOswnkv9MTShO7W_gq9v-z_jbGG1NLfzwK5sL5f9gRPJB8DJ0XKW0LmitHmMIBs9qtJHrjMojjaHtH9E60DE.mp4?_nc_cat=106&_nc_sid=5e9851&_nc_ht=scontent-bos5-1.cdninstagram.com&_nc_ohc=qto9CsTQxX4Q7kNvwFH_O3S&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNTc2LmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MjcyMzE4NDgzMTY0OTg0MjgsImFzc2V0X2FnZV9kYXlzIjo3LCJ2aV91c2VjYXNlX2lkIjoxMDA5OSwiZHVyYXRpb25fcyI6MjIsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=a969155a9f82cabd&_nc_&_nc_gid=H_OpDHTMaKNiOj-sfiWwvw&_nc_ss=7d689&_nc_zt=28&oh=00_AQByohL6XGbgMKvQwdKej9wzjQWlbBGZ6eJR_F0hSxiHsA&oe=6A5EA28B", "musicInfo": {"artist_name": "mama_mila_au", "song_name": "Original audio", "uses_original_audio": true, "should_mute_audio": false, "should_mute_audio_reason": "", "audio_id": "27568277519494987"}, "ownerUsername": "mama_mila_au", "ownerFullName": "Chantel Mila", "transcript": "This is just that everyone should know, but no one ever teaches you. Place rice and lemon oil in your wardrobes to keep mold and moisture away. To repel flies, place cloves inside a lemon and place this around your kitchen. And you guys already know how much I love to boil lemon, clove, and vanilla to make your home smell amazing. Remove makeup stains instantly using shaving cream, and shaving cream is also amazing at cleaning mirrored appliances around the home.", "history": [{"date": "2026-07-18", "plays": 148737, "likes": 1852, "comments": 15}, {"date": "2026-07-19", "plays": 149534, "likes": 1858, "comments": 15}], "still_climbing": false, "hook_type": "Education", "is_relevant": true}, {"shortCode": "DahbaheSnSW", "url": "https://www.instagram.com/p/DahbaheSnSW/", "caption": "You only need one pantry ingredient to make an all natural spider spray (without the harsh fumes!) \ud83d\udd77\ufe0f\ud83d\udd78\ufe0f this is one of my favourite natural spider hacks!\n\nI\u2019ve been using a simple salt water spray around my home, and I\u2019ve found it helps keep spiders away. With Mila\u2019s asthma, we try to avoid harsh aerosols where possible, so this is an easy, gentle alternative to harsh sprays that I\u2019ve had good success with. Be mindful with use around marble and stone or any finish that doesn\u2019t tolerate salt water. \n\nHave you ever tried this trick? I\u2019d love to know if it worked for you too \u2665\ufe0f \n\n#homehacks #spiderhack #cleaninghack #cleaningtips #mamamilastips", "timestamp": "2026-07-08T06:46:47.000Z", "videoDuration": 16.369, "videoPlayCount": 170513, "videoViewCount": 39156, "likesCount": -1, "commentsCount": 42, "displayUrl": "https://instagram.fbne9-1.fna.fbcdn.net/v/t51.82787-15/743146024_18100146665190993_2628446241362769856_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=instagram.fbne9-1.fna.fbcdn