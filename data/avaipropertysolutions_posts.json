c__fSbnrfjBBUCKAJDMywXQERVP3ztkWgYEmRhc2hfYmFzZWxpbmVfMV92MREAdf4HZeadAQA&_nc_gid=b6HO8hJmh9b0C7KgHkP7bQ&_nc_zt=28&_nc_ss=7a22e&oh=00_AQIIWU0VesmsiYZKCiM5k93DYDtV05eO8BZra2z_8vY3xg&oe=6A96181C", "musicInfo": {"artist_name": "Company Money", "song_name": "Drop Top Summer (Instrumental)", "uses_original_audio": false, "should_mute_audio": false, "should_mute_audio_reason": "", "audio_id": "1487687659527390"}, "ownerUsername": "avaipropertysolutions", "ownerFullName": "Sarasota\u2019s Premier Cleaning Service", "history": [{"date": "2026-08-16", "plays": 893, "likes": 22, "comments": 10}, {"date": "2026-08-23", "plays": 991, "likes": 24, "comments": 10}, {"date": "2026-08-30", "plays": 1042, "likes": 25, "comments": 12}], "still_climbing": false, "is_relevant": true, "transcript": "Three things you need to be doing at every job site. Take pictures. Documenting before and after pictures covers all bases, guarantees the work being done, and gives you references to work off of next time. Use a checklist. Don't keep track of everything in your brain. That just causes forgetting tasks, causing more callbacks. Working off of a checklist keeps you efficient and on track. No job is the same. Write down specific job notes, door codes, gate codes, property specifics at the palm of your hand and not the top of your head. No more scrolling messages of what your client texted you months ago. Keep everything all in one place. Comment checklists and I'll show you what I use.", "hook_type": "List"}]}