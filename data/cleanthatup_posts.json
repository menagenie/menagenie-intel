ould_mute_audio_reason": "", "audio_id": "27458267253858356"}, "ownerUsername": "cleanthatup", "ownerFullName": "Brandon Pleshek", "transcript": "If you're looking for a free and super helpful way to keep your home clean every single week, this video is for you. Now my dad and I send out a newsletter called the Clean Freak Weekly every single Tuesday, and it is packed full of helpful cleaning tips and tricks and ways to make cleaning just a little bit easier and hopefully more fun too. Now my dad, he's been cleaning professionally for over 40 years. Myself, I've been cleaning for 20 years. So every single issue we try to take all of that cleaning knowledge and boil it down into easy bite-sized nuggets that you can implement into your cleaning routine every single week. Now I will say we're at like 18,000 subscribers, something like that, and our goal by the end of this month is to reach 20,000 subscribers and then we're going to do a giveaway. So if you want to sign up and help us reach that goal plus get all of this cleaning knowledge delivered to your inbox every single week, all you got to do is comment the word newsletter and I'll see you over there.", "history": [{"date": "2026-07-18", "plays": 54545, "likes": 1116, "comments": 1064}, {"date": "2026-07-19", "plays": 54956, "likes": 1124, "comments": 1073}, {"date": "2026-07-26", "plays": 68538, "likes": 1331, "comments": 1320}, {"date": "2026-08-02", "plays": 74819, "likes": 1403, "comments": 1382}], "still_climbing": false, "hook_type": "Education", "is_relevant": true}, {"shortCode": "Dav32l1hNAN", "url": "https://www.instagram.com/p/Dav32l1hNAN/", "caption": "Cleaning up my daughters shoes", "timestamp": "2026-07-13T21:24:35.000Z", "videoDuration": 56.91, "videoPlayCount": 117837, "videoViewCount": 3970, "likesCount": 3685, "commentsCount": 28, "displayUrl": "https://instagram.fyvr4-1.fna.fbcdn.net/v/t51.82787-15/745011505_18443838799140899_7577029075806263408_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_