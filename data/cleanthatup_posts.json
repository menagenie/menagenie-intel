d=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEzMjAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=pnhvHeU9Qi0Q7kNvwHsuc9g&_nc_oc=AdpTLX9QyXld2_4UZvrGRiS4VlKNQ1QTja0myruvvnuHM34vZiUM_O3RImaK2b8vppM&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-ssn1-1.cdninstagram.com&_nc_gid=xhV-OjBChN9quLOK9w-yFg&_nc_ss=7a22e&oh=00_AQLnBGRXlXn_-xeRd7easJlsPOAv0o8BQHpFOsLNRDSHBA&oe=6A9A2A7C", "videoUrl": "https://scontent-ssn1-1.cdninstagram.com/o1/v/t2/f2/m367/AQP-pJFFBkhSLQfzyTf1h3z8VF8Zbw8I0Lav9BCo94O5Gw5R0HAGJ1-YAHmBVGs1nGUXvYapjhCgARNXd2u5XnAFBM8AvalR6xY5vpo.mp4?_nc_cat=108&_nc_sid=9ca052&_nc_ht=scontent-ssn1-1.cdninstagram.com&_nc_ohc=Uc4J9nK828YQ7kNvwGmikbA&%3D&ccb=17-1&_nc_gid=xhV-OjBChN9quLOK9w-yFg&_nc_ss=7a22e&_nc_zt=28&oh=00_AQKgJlPpth4NioMRElJ-6AMTucv7ZKzgsqadBKDcr2K7rw&oe=6A9A0E85", "musicInfo": {"artist_name": "The Fame Gang", "song_name": "Soulful Strut (Instrumental)", "uses_original_audio": false, "should_mute_audio": false, "should_mute_audio_reason": "", "audio_id": "430493994091859"}, "ownerUsername": "cleanthatup", "ownerFullName": "Brandon Pleshek", "history": [{"date": "2026-08-16", "plays": 66093, "likes": 1306, "comments": 20}, {"date": "2026-08-23", "plays": 75678, "likes": 1517, "comments": 20}, {"date": "2026-08-30", "plays": 77683, "likes": 1562, "comments": 20}], "still_climbing": false, "is_relevant": false, "transcript": "To really level up your car wash and make your car sparkle, there are a few things I'd like to recommend you do. First, just clean all the windows with a glass cleaner. For instance, I like to use invisible glass because it's safe on tint. Now one thing when you're washing your windows, always use a two towel system. That way you can clean with one towel and dry and buff with the other. That way you won't leave any streaks behind. An area that you don't want to miss is the top of the window there, so make sure you always roll it down to clean that top. That way there's not that dirty line left behind. The second thing is to get your wheels looking nice and shiny. Now for this, I like to use this product here called VRP from Chemical Guys. It works really well. Just apply it to the tire right here and it should be nice and shiny. Now I will say the other thing that's really nice about this, this is called vinyl, rubber, and plastic. So if you do have any like black plastic that looks a little sun faded, just add a very little bit of this and it will bring it back to life."}, {"shortCode": "DbofvChPAVo", "url": "https://www.instagram.com/p/DbofvChPAVo/", "caption": "Hair dryer smell like burning or not working right? It might be time to clean it!", "timestamp": "2026-08-04T21:10:10.000Z", "videoDuration": 27.799999, "videoPlayCount": 336422, "videoViewCount": null, "likesCount": 5561, "commentsCount": 19, "displayUrl": "https://scontent-cdg4-2.cdninstagram.com/v/t51.82787-15/764006268_18447826732140899_5583328255336417053_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=101&ig_cache_key=Mzk1NjU1MTg0NDYwNzI5Njg3MjE4NDQ3ODI2NzI5MTQwODk5.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEzMjAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=ILeGikwgCh8Q7kNvwFlOS9_&_nc_oc=Adr1HNi7IMs3vUPoko4-0_u_OY4i97A8PIjymMnwRow65VxXtJMZlnD1dGMY2xLJUxE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-cdg4-2.cdninstagram.com&_nc_gid=XapKvwqJXptzroSWVB-YNw&_nc_ss=7a22e&oh=00_AQKQpWoNG4jCeb5PkJlMjoRKo89L31ZHlfQcIznfnFFw5w&oe=6A9A18DA", "videoUrl": "https://scontent-cdg4-2.cdninstagram.com/o1/v/t2/f2/m86/AQP78QPydBFMjI-rez1oNomzSizJyT16ohcrKPNYTuVCVzcosayZc4thPDKnR57BSImWnsWrhgHJfwIQwpMdM5GQGcXPrtSqsHH3wKc.mp4?_nc_cat=100&_nc_sid=5e9851&_nc_ht=scontent-cdg4-2.cdninstagram.com&_nc_ohc=WBXtZj6t-PUQ7kNvwHxIzxe&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTYxMzAzNjk4Mzg0NzM4MCwiYXNzZXRfYWdlX2RheXMiOjI1LCJ2aV91c2VjYXNlX2lkIjoxMDA5OSwiZHVyYXRpb25fcyI6MjcsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=ad48