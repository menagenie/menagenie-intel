ER HOT. \ud83e\udd75 \n\nWhat\u2019s your favorite low-effort family meal? \ud83d\ude0d\ud83d\udc47\ud83d\udc47\ud83d\udc47\n\n#familymeals #dinneridea #loweffortdinner #easyrecipes #easydinners", "timestamp": "2026-07-28T00:40:31.000Z", "videoDuration": 29.789751, "videoPlayCount": 1813, "videoViewCount": 273, "likesCount": 10, "commentsCount": 3, "displayUrl": "https://scontent-fra5-2.cdninstagram.com/v/t51.82787-15/758368275_18422062990178865_7080504592451444956_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=106&ig_cache_key=Mzk1MDg2NzU1NTkyNTAyNzEyNjE4NDIyMDYyOTg0MTc4ODY1.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=cOenwgiuttQQ7kNvwFmRGCF&_nc_oc=AdpXIoQxhuf7R-vzY6iMxgKB2whTol88FFhbKt0pVBdNfVzmR1wDW8mQuge9k2lxBMI&_nc_zt=23&_nc_ht=scontent-fra5-2.cdninstagram.com&_nc_gid=7yEvx0UqCHjfjJF5wHdSSQ&_nc_ss=72a8c&oh=00_AQEziJNXjmMbM4X3F3Q-VmQZ2mQfSGtxS-WYwnGk2v-Nvg&oe=6A90A26E", "videoUrl": "https://scontent-fra3-2.cdninstagram.com/o1/v/t2/f2/m86/AQNWaaKrtJswlNaKIX9zI4d5Iw65GSXKCIYVisUF2Vr9zlRIIyAY89iuADGqLqhTpPHfIDjEefaUCtSDp_yk-clhLQb13VCUgm8g0gg.mp4?_nc_cat=111&_nc_sid=5e9851&_nc_ht=scontent-fra3-2.cdninstagram.com&_nc_ohc=SEkq71OrymEQ7kNvwHxq2ME&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTQ2MjA5ODY5OTI4MzkxNSwiYXNzZXRfYWdlX2RheXMiOjI2LCJ2aV91c2VjYXNlX2lkIjoxMDA5OSwiZHVyYXRpb25fcyI6MjksInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=ae1883bf7b130f9d&_nc_&_nc_gid=7yEvx0UqCHjfjJF5wHdSSQ&_nc_ss=72a8c&_nc_zt=28&oh=00_AQEUYAbm0JwPV9FM6WGIIEWo1DcLc038-4KqKEENSfYPOw&oe=6A8CCD84", "musicInfo": {"artist_name": "Edith Whiskers", "song_name": "Home", "uses_original_audio": false, "should_mute_audio": false, "should_mute_audio_reason": "", "audio_id": "1191936897852538"}, "ownerUsername": "slayathomemother", "ownerFullName": "Corinne Burghardt \ud83c\udfe1 \u2728 Slay At Home Mother", "history": [{"date": "2026-08-02", "pla